{
  "global": {
    "files": "/build/cloud/src/**/*.*",
    "exclude": [
      "/build/cloud/src/app/"
    ],
    "noIssues": [
      "/build/cloud/src/vendor/*",
      "z2fiori_cl_xml_view_builder.clas.abap"
    ]
  },
  "dependencies": [
    {
      "folder": "/deps/open-abap-core",
      "files": "/src/**/*.*"
    }
  ],
  "syntax": {
    "version": "Cloud",
    "errorNamespace": "."
  },
  "rules": {
    "downport": false,
    "begin_end_names": true,
    "check_ddic": true,
    "check_include": true,
    "check_syntax": true,
    "global_class": true,
    "definitions_top": false,
    "implement_methods": true,
    "method_implemented_twice": true,
    "parser_error": true,
    "superclass_final": true,
    "unknown_types": true,
    "xml_bom": true,
    "xml_consistency": true
  }
}