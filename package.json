{
  "name": "abaplit",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node scripts/server.mjs",
    "dev": "node scripts/server.mjs",
    "clean": "node scripts/clean.mjs",
    "deps": "git submodule update --init --recursive",
    "pull": "node scripts/pull_ajson.mjs",
    "lint": "abaplint",
    "lint:fix": "abaplint --fix",
    "build": "npm run clean && abap_transpile abaplint-transpiler.json",
    "bundle:abap": "node scripts/bundle_to_abap.mjs",
    "test": "node scripts/test_binding.mjs && npm run clean && abap_transpile abaplint-transpiler.json && node --expose-gc output/index.mjs",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@abaplint/cli": "latest",
    "@abaplint/runtime": "latest",
    "@abaplint/transpiler-cli": "latest",
    "@playwright/test": "^1.63.0",
    "abap-kit": "latest"
  }
}
