{
  "name": "abap2fiori",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && abap_transpile abaplint-transpiler.json",
    "build:dist": "node scripts/build_dist.mjs",
    "deploy": "node scripts/deploy_branches.mjs",
    "release": "node scripts/deploy_branches.mjs",
    "lint": "abaplint",
    "lint:fix": "abaplint --fix",
    "lint:cloud": "abaplint abaplint-cloud.json",
    "lint:downport": "abaplint abaplint-downport.json",
    "downport": "node -e \"import('./scripts/downport.mjs').then(m => m.downportDirectory('src'))\"",
    "unit": "npm run build && node --expose-gc output/index.mjs",
    "test": "npm run lint && npm run lint:cloud && npm run unit",
    "deps": "git submodule update --init --recursive"
  },
  "devDependencies": {
    "@abaplint/cli": "latest",
    "@abaplint/database-sqlite": "latest",
    "@abaplint/runtime": "latest",
    "@abaplint/transpiler-cli": "latest",
    "abap-kit": "latest"
  }
}
