    "! sap.m.semantic.CancelAction sap.m.semantic.FlagAction
    "! sap.m.semantic.FavoriteAction sap.m.semantic.OpenInAction
    "! sap.m.semantic.DiscussInJamAction sap.m.semantic.ShareInJamAction
    "! sap.m.semantic.SendEmailAction sap.m.semantic.SendMessageAction
    "! sap.m.semantic.PrintAction sap.m.semantic.MessagesIndicator sap.m.DraftIndicator
