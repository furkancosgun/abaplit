        total_count                  TYPE clike OPTIONAL
        selected_count               TYPE clike OPTIONAL
        show_extended_view           TYPE clike OPTIONAL
      RETURNING
        VALUE(result) TYPE REF TO z2fiori_cl_xml_view_builder.

